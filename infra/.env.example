# Copiá este archivo a .env (en la misma carpeta infra/) y completá tu clave.
# El archivo .env NO se sube a GitHub (está en .gitignore) — tu clave queda
# solo en tu máquina, de forma segura.
#
# Después de crear el .env, levantás con:  docker compose up -d
# y la IA funciona sola, sin volver a configurar la clave.

# Tu clave de Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=pega_tu_clave_aca

# Modelo de IA (dejá este que anda bien para cuentas nuevas):
GEMINI_MODEL=gemini-flash-lite-latest
