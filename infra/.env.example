# Copiá este archivo a .env (en la misma carpeta infra/) y completá tu clave.
# El archivo .env NO se sube a GitHub (está en .gitignore) — tu clave queda
# solo en tu máquina, de forma segura.
#
# Después de crear el .env, levantás con:  docker compose up -d
# y la IA funciona sola, sin volver a configurar la clave.

# Tu clave de Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=pega_tu_clave_aca

# Modelo de IA (dejá este que anda bien para cuentas nuevas):
GEMINI_MODEL=gemini-flash-lite-latest

# Secreto aleatorio compartido entre documentos-service y extraccion-service.
INTERNAL_SERVICE_API_KEY=

# Token opcional para Consul ACL. Inyectalo con un gestor de secretos o un
# archivo .env local excluido de Git; nunca lo guardes en el repositorio.
CONSUL_HTTP_TOKEN=

# Images of the integrated stack. Remote service versions are full Git commit
# SHAs and also select the SERVICE_REF used by their remote builds.
# "dev" is only for local builds of this repository; releases must use a full
# commit SHA for every service, including ORQUESTADOR_VERSION.
IMAGE_NAMESPACE=pdf-ms
DOCUMENTOS_VERSION=0eb92bb2b5033b340f942bfa59e1081887d5b348
EXTRACCION_VERSION=904e5bee97ddbcf5e3f2781a199bdf7038442b6a
RESUMEN_VERSION=769a21207adc191b315c855ea853ac280ab885a5
NOTIFICACIONES_VERSION=35e6d9063a54a92bc1535471d0f187ee535bbbac
ORQUESTADOR_VERSION=dev
