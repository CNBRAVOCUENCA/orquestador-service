FROM python:3.12-slim

ARG SERVICE_REPO

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=30 \
    PIP_RETRIES=3

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && git clone --depth 1 --branch main "$SERVICE_REPO" /tmp/service \
    && cp /tmp/service/pyproject.toml /tmp/service/README.md ./ \
    && cp -r /tmp/service/App ./App \
    && rm -rf /tmp/service /var/lib/apt/lists/*

RUN pip install --no-cache-dir "setuptools>=68" wheel \
    && pip install --no-cache-dir --no-build-isolation .

EXPOSE 8000

CMD ["uvicorn", "App.main:app", "--host", "0.0.0.0", "--port", "8000"]