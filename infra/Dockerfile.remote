FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS source

ARG SERVICE_REPO
ARG SERVICE_REF

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && git clone --depth 1 "$SERVICE_REPO" /tmp/service \
    && git -C /tmp/service fetch --depth 1 origin "$SERVICE_REF" \
    && git -C /tmp/service checkout --detach "$SERVICE_REF" \
    && rm -rf /var/lib/apt/lists/*

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS builder

WORKDIR /app

# uv fijado a una version exacta para que el build sea reproducible
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=source /tmp/service/pyproject.toml /tmp/service/uv.lock /tmp/service/README.md ./

# Instala dependencias antes de copiar el codigo para reutilizar esta capa.
RUN uv sync --locked --no-dev --no-install-project

COPY --from=source /tmp/service/App ./App

# Instala exactamente lo que fija el uv.lock del servicio (falla si esta desactualizado)
RUN uv sync --locked --no-dev

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/App ./App

EXPOSE 8000

CMD ["uvicorn", "App.main:app", "--host", "0.0.0.0", "--port", "8000"]
