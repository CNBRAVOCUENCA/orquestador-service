APP_NAME=orquestador-service
DEBUG=false
# Host local de Traefik para abrir la interfaz del orquestador.
ORQUESTADOR_HOST=orquestador.localhost
DOCUMENTOS_URL=http://localhost:8001
EXTRACCION_URL=http://localhost:8002
RESUMEN_URL=http://localhost:8003
NOTIFICACIONES_URL=http://localhost:8004
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
RESUMEN_MAX_WORDS=150
API_V1_PREFIX=/api/v1
GEMINI_API_KEY=
# Secreto aleatorio compartido entre documentos-service y extraccion-service.
INTERNAL_SERVICE_API_KEY=

# Images of the integrated stack. Remote service versions are full Git commit
# SHAs and also select the SERVICE_REF used by their remote builds.
# "dev" is only for local builds of this repository; releases must use a full
# commit SHA for every service, including ORQUESTADOR_VERSION.
IMAGE_NAMESPACE=pdf-ms
DOCUMENTOS_VERSION=22c263003a4bedd141ea90c4251e11789dfcc9f5
EXTRACCION_VERSION=44b631c9567f57fb5d63decbda1905114cbaefad
RESUMEN_VERSION=55d04bdb635af7c49e83dfd5b87c9e3fab379731
NOTIFICACIONES_VERSION=ee4a91869644237c7a91fdc96674438d8847bf15
ORQUESTADOR_VERSION=dev
